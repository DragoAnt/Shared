<Project>

  <PropertyGroup>
    <TargetFrameworks>net7.0;net8.0;net9.0;netstandard2.0;netstandard2.1</TargetFrameworks>
    <Copyright>Copyright (c) 2025 DragoAnt</Copyright>

    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);EF1001;</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <MSKit_TestsAssertions>FluentAssertions</MSKit_TestsAssertions>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory).toolkit/msbuild/init.props" />

  <PropertyGroup Condition="'$(IsTestsProject)'=='True'">
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
  </PropertyGroup>

</Project>
