<Project>

  <Import Project="$(MSBuildThisFileDirectory).toolkit/msbuild/init.targets" />

  <!-- DynamicallyAccessedMemberTypes.None collides with enum members named None, and the type is missing on netstandard2.1. -->
  <ItemGroup>
    <Using Remove="System.Diagnostics.CodeAnalysis.DynamicallyAccessedMemberTypes" />
  </ItemGroup>

</Project>
